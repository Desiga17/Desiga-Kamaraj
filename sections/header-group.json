    "custom_liquid_kQkMTB": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<div class=\"custom-grid-section-new\">\n  <div class=\"grid-container-new\">\n    <!-- Store Products Dynamic Loop (6 items) -->\n    {%- for product in collections.all.products limit: 6 -%}\n      <div class=\"product-card-new\">\n        <img src=\"{{ product.featured_image | img_url: 'medium' }}\" alt=\"{{ product.title }}\">\n        <h3>{{ product.title }}</h3>\n        <p>{{ product.price | money }}</p>\n        <button class=\"open-popup-btn-new\" data-product-handle=\"{{ product.handle }}\">View Options</button>\n      </div>\n    {%- else -%}\n      {%- for i in (1..6) -%}\n        <div class=\"product-card-new placeholder\">\n          <div class=\"placeholder-img-new\">Product Image</div>\n          <h3>Sample Product {{ i }}</h3>\n          <p>$19.99</p>\n          <button class=\"open-popup-btn-new\">View Options</button>\n        </div>\n      {%- endfor -%}\n    {%- endfor -%}\n  </div>\n</div>\n\n<!-- Popup Modal HTML -->\n<div id=\"customProductModalNew\" class=\"custom-modal-new\" style=\"display: none;\">\n  <div class=\"modal-content-new\">\n    <span class=\"close-modal-btn-new\">&times;</span>\n    <h2 id=\"modalProductTitleNew\">Product Title</h2>\n    <p id=\"modalProductPriceNew\">Price</p>\n    <div id=\"modalProductDescriptionNew\">Description</div>\n    <div id=\"modalProductVariantsNew\" class=\"variants-wrapper-new\"></div>\n    <button id=\"modalAddToCartBtnNew\" class=\"modal-atc-btn-new\">ADD TO CART</button>\n  </div>\n</div>\n\n<style>\n.custom-grid-section-new { padding: 40px 20px; background-color: #f9f9f9; }\n.grid-container-new { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; max-width: 1200px; margin: 0 auto; }\n.product-card-new { background: #fff; padding: 20px; border: 1px solid #e5e5e5; border-radius: 4px; text-align: center; }\n.product-card-new img, .placeholder-img-new { width: 100%; height: 220px; object-fit: cover; background: #eee; margin-bottom: 15px; }\n.open-popup-btn-new { width: 100%; padding: 10px; background: #121212; color: #fff; border: none; cursor: pointer; font-weight: bold; }\n.custom-modal-new { position: fixed; z-index: 99999; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; }\n.modal-content-new { background: #fff; padding: 30px; max-width: 450px; width: 90%; position: relative; border-radius: 4px; text-align: left; }\n.close-modal-btn-new { position: absolute; right: 15px; top: 10px; font-size: 28px; cursor: pointer; }\n.variants-wrapper-new { margin: 15px 0; }\n.variant-selector-new { width: 100%; padding: 10px; margin-top: 5px; }\n.modal-atc-btn-new { width: 100%; padding: 12px; background: #121212; color: #fff; border: none; font-weight: bold; cursor: pointer; }\n.modal-atc-btn-new:hover { background: #ff0000; }\n@media (max-width: 749px) { .grid-container-new { grid-template-columns: repeat(2, 1fr); gap: 10px; } }\n</style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n  const modal = document.getElementById(\"customProductModalNew\");\n  const closeBtn = document.querySelector(\".close-modal-btn-new\");\n  let selectedVariantId = null;\n\n  document.querySelectorAll(\".open-popup-btn-new\").forEach(btn => {\n    btn.addEventListener(\"click\", function() {\n      const handle = this.getAttribute(\"data-product-handle\");\n      if(!handle) return;\n      fetch(`/products/${handle}.js`)\n        .then(res => res.json())\n        .then(product => {\n          document.getElementById(\"modalProductTitleNew\").innerText = product.title;\n          document.getElementById(\"modalProductPriceNew\").innerText = (product.price / 100).toLocaleString(\"en-US\", {style:\"currency\", currency: product.currency || \"USD\"});\n          document.getElementById(\"modalProductDescriptionNew\").innerHTML = product.description;\n          const varContainer = document.getElementById(\"modalProductVariantsNew\");\n          varContainer.innerHTML = \"\";\n          if(product.variants.length > 1) {\n            let html = '<label>Select Options:</label><select id=\"variantSelectBoxNew\" class=\"variant-selector-new\">';\n            product.variants.forEach(v => { html += `<option value=\"${v.id}\" data-title=\"${v.title}\">${v.title}</option>`; });\n            html += '</select>';\n            varContainer.innerHTML = html;\n            selectedVariantId = product.variants[0].id;\n            document.getElementById(\"variantSelectBoxNew\").addEventListener(\"change\", function() { selectedVariantId = this.value; });\n          } else {\n            selectedVariantId = product.variants[0].id;\n          }\n          modal.style.display = \"flex\";\n        });\n    });\n  });\n  if(closeBtn) closeBtn.addEventListener(\"click\", () => modal.style.display = \"none\");\n  document.getElementById(\"modalAddToCartBtnNew\").addEventListener(\"click\", function() {\n    if(!selectedVariantId) return;\n    let items = [{ id: parseInt(selectedVariantId), quantity: 1 }];\n    const selectBox = document.getElementById(\"variantSelectBoxNew\");\n    if(selectBox) {\n      const txt = selectBox.selectedOptions[0].getAttribute(\"data-title\").toLowerCase();\n      if(txt.includes(\"black\") && txt.includes(\"medium\")) {\n        items.push({ id: 'SOFT_WINTER_JACKET_VARIANT_ID', quantity: 1 });\n      }\n    }\n    fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: items }) })\n    .then(res => res.json())\n    .then(() => { alert(\"Product added to cart!\"); modal.style.display = \"none\"; window.location.reload(); });\n  });\n});\n</script>",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
